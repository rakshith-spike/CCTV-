# Export variables in your shell before ./start.sh (this file is documentation).
CCTV_SAMPLE_FPS=1
CCTV_DEVICE=auto
CCTV_CLIP_BEFORE=10
CCTV_CLIP_AFTER=10
CCTV_MAX_UPLOAD_MB=2048
# CCTV_DATA_DIR=/absolute/path/to/private/data
# CCTV_PYTHON=python3.11
# Changing the embedding model requires a compatible CLIPModel checkpoint and re-indexing.
CCTV_EMBEDDING_MODEL=openai/clip-vit-base-patch32
